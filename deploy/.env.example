# Copier ce fichier en .env sur le serveur et remplir les valeurs.
# Ne jamais committer le fichier .env réel.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=mandel.exemple.sn
DJANGO_CSRF_TRUSTED_ORIGINS=https://mandel.exemple.sn
# Base Django : hors du dossier public
DJANGO_SQLITE_PATH=/home/mediapla/neo_mand_data/db.sqlite3
# Fichiers servis par le serveur web (dans public/)
DJANGO_STATIC_ROOT=/home/mediapla/public_html/neo_mand/public/static
DJANGO_MEDIA_ROOT=/home/mediapla/public_html/neo_mand/public/media
MANDEL_DB_HOST=localhost
MANDEL_DB_NAME=mediapla_mandel
MANDEL_DB_USER=mediapla
MANDEL_DB_PASSWORD=remplacer-par-le-mot-de-passe-mysql
MANDEL_SOCIETE_ID=1
